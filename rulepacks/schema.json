{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PramaanAI Rule Pack",
  "type": "object",
  "required": ["pack", "version", "effective_from", "academic_year_start", "rules"],
  "properties": {
    "pack": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "effective_from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "academic_year_start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "constants": { "type": "object" },
    "risk": { "type": "object" },
    "categories": { "type": "object" },
    "rules": { "type": "array", "items": { "$ref": "#/definitions/rule" } }
  },
  "definitions": {
    "citation": {
      "type": "object",
      "required": ["source", "clause", "page"],
      "properties": { "source": { "type": "string" }, "clause": { "type": "string" }, "page": { "type": "integer" } }
    },
    "rule": {
      "type": "object",
      "required": ["id", "title", "applies_to", "type", "severity", "message", "citation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]*$" },
        "title": { "type": "string" },
        "applies_to": { "type": "object" },
        "when": { "type": "string" },
        "type": { "enum": ["document_required", "field_required", "expiry", "formula", "timeline", "consistency", "threshold"] },
        "severity": { "enum": ["CRITICAL", "MAJOR", "MINOR", "INFO"] },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "citation": { "$ref": "#/definitions/citation" },
        "let": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
        "check": { "type": "string" },
        "document_type": { "type": "string" },
        "requires": { "type": "array", "items": { "type": "string" } },
        "fields": { "type": "array", "items": { "type": "string" } },
        "field": { "type": "string" },
        "valid_on": { "type": "string" },
        "attribute": { "type": "string" },
        "sources": { "type": "array" },
        "reference": { "type": "string" },
        "threshold": { "type": "number" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["formula", "threshold", "timeline"] } } }, "then": { "required": ["check"] } },
        { "if": { "properties": { "type": { "const": "document_required" } } }, "then": { "required": ["document_type"] } },
        { "if": { "properties": { "type": { "const": "field_required" } } }, "then": { "required": ["document_type", "fields"] } },
        { "if": { "properties": { "type": { "const": "expiry" } } }, "then": { "required": ["document_type", "field", "valid_on"] } },
        { "if": { "properties": { "type": { "const": "consistency" } } }, "then": { "required": ["attribute", "sources", "reference", "threshold"] } }
      ]
    }
  }
}
